<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- The generator driver runs synchronously and does not observe the test cancellation token. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!--
    Tests run the trim analyzer (IL2026) over generated code. Only its analyzer assembly is used, so the
    package assets are excluded and the test project itself is not trim analyzed. The 8.0 analyzer is
    built against a Roslyn version that the Microsoft.CodeAnalysis.CSharp reference above can load.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" VersionOverride="8.0.32" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgMicrosoft_NET_ILLink_Tasks)\analyzers\dotnet\cs\ILLink.RoslynAnalyzer.dll" Link="ILLink\ILLink.RoslynAnalyzer.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharprompt\Sharprompt.csproj" />
    <ProjectReference Include="..\..\src\Sharprompt.SourceGenerator\Sharprompt.SourceGenerator.csproj" />
  </ItemGroup>

</Project>
